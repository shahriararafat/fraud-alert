# Copy to .env.local. Values come from `supabase status` after `supabase start`.
# Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_. Not used by the browser.
SUPABASE_SECRET_KEY=

# Google OAuth. Leave blank until you create a Google Cloud web client.
# The local CLI reads these from the environment when you run `supabase start`.
# Authorized redirect URIs:
#   http://127.0.0.1:54321/auth/v1/callback
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
